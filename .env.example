# Universal Communication Intelligence - Environment Configuration
# Execution Mode: private_offline | hybrid | cloud
UNICOM_EXECUTION_MODE=private_offline

# Server Configuration
UNICOM_PORT=3000
UNICOM_HOST=0.0.0.0
UNICOM_LOG_LEVEL=info

# Storage Configuration
UNICOM_DATA_DIR=./data
UNICOM_MODELS_DIR=./models

# Optional Cloud Provider Configuration (only accessed when mode is 'hybrid' or 'cloud')
# Never populated by default; remains blank in private_offline mode
OPENAI_API_KEY=
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
ANTHROPIC_API_KEY=
